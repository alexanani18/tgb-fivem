{
  "name": "tgb-fivem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "server": "tsx lib/index.ts",
    "server:dev": "tsx watch lib/index.ts",
    "dev:all": "npm run db:ensure && concurrently --kill-others-on-fail --names \"API,WEB\" \"npm run server:dev\" \"npm run dev\"",
    "db:ensure": "tsx database/scripts/ensure.ts",
    "db:install": "tsx database/scripts/install.ts",
    "db:reset": "tsx database/scripts/reset.ts",
    "db:fresh": "npm run db:reset && npm run db:install",
    "discord:import-roles": "tsx database/scripts/importDiscordRoles.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "lucide-react": "^1.28.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "next": "16.2.12",
    "nodemon": "^3.1.14",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.4",
    "typescript": "^5"
  }
}
